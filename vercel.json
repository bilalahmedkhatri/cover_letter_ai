{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "www\\.ailettergen\\.com" }],
      "destination": "https://ailettergen.com/en",
      "permanent": true
    },
    {
      "source": "/:page(dashboard|about|privacy|terms)",
      "has": [{ "type": "host", "value": "www\\.ailettergen\\.com" }],
      "destination": "https://ailettergen.com/en/:page",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www\\.ailettergen\\.com" }],
      "destination": "https://ailettergen.com/:path*",
      "permanent": true
    },
    { "source": "/", "destination": "/en", "permanent": true },
    {
      "source": "/:page(dashboard|about|privacy|terms)",
      "destination": "/en/:page",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/:locale(en|es|fr|ru|nl|pt|ar)",
      "destination": "/index.html"
    },
    {
      "source": "/:locale(en|es|fr|ru|nl|pt|ar)/:page(dashboard|about|privacy|terms)",
      "destination": "/index.html"
    }
  ]
}
