{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "www\\.ailettergen\\.com"
        }
      ],
      "destination": "https://ailettergen.com/en",
      "permanent": true
    },
    {
      "source": "/:page(dashboard|about|privacy|terms|pricing|features|guides|compare)",
      "has": [
        {
          "type": "host",
          "value": "www\\.ailettergen\\.com"
        }
      ],
      "destination": "https://ailettergen.com/en/:page",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www\\.ailettergen\\.com"
        }
      ],
      "destination": "https://ailettergen.com/:path*",
      "permanent": true
    },
    {
      "source": "/",
      "destination": "/en",
      "permanent": true
    },
    {
      "source": "/:page(dashboard|about|privacy|terms|pricing|features|guides|compare)",
      "destination": "/en/:page",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/:locale(en|es|fr|ru|nl|pt|ar)",
      "destination": "/:locale/index.html"
    },
    {
      "source": "/:locale(en|es|fr|ru|nl|pt|ar)/:page(dashboard|about|privacy|terms|pricing|features|guides|compare)",
      "destination": "/:locale/:page/index.html"
    }
  ]
}
