# Server-only: never prefix payment/storage secrets with VITE_.
NOWPAYMENT_API_KEY=
NOWPAYMENT_IPN_KEY=
# NOWPAYMENT_PUBLIC_KEY is not required for hosted invoices.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
# Public blog: optional SELECT-only connection to THIS app's same database.
# When empty, reuses DATABASE_URL via the installed Neon HTTP driver.
BLOG_DATABASE_URL=
# Exact HTTPS public B2/CDN origins, comma-separated; never upload credentials.
BLOG_MEDIA_ORIGINS=https://YOUR_PUBLIC_BUCKET_HOST.backblazeb2.com
BILLING_SITE_URL=https://ailettergen.com
# Keep disabled until paid AI entitlement enforcement is implemented and launch-tested.
BILLING_ENABLE_CHECKOUT=true
# Sandbox needs a separate NOWPayments sandbox account/key/IPN secret.
NOWPAYMENTS_SANDBOX=false

# Neon Auth: configuration stays server-only; the old VITE URL is unused.
NEON_AUTH_BASE_URL=
NEON_AUTH_JWKS_URL=
# Legacy JWT verification: keep exact issuer/audience when they differ from NEON_AUTH_BASE_URL.
NEON_AUTH_ISSUER=
NEON_AUTH_AUDIENCE=
# Server-only random secret (minimum 32 characters).
NEON_AUTH_COOKIE_SECRET=

# Server-only gateway configuration. Never prefix API keys with NEXT_PUBLIC_.
AI_GATEWAY_QUERY_URL=http://localhost:8000/api/v1/query/
# Cover letters use prompt-only generation. If omitted, derived from the /query/ URL.
AI_GATEWAY_GENERATE_URL=http://localhost:8000/api/v1/generate/
# Match deployed FastAPI GENERATION_MAX_PROMPT_CHARS and GENERATION_MAX_BODY_BYTES.
AI_GATEWAY_GENERATE_MAX_PROMPT_CHARS=32768
AI_GATEWAY_GENERATE_MAX_BODY_BYTES=524288
AI_GATEWAY_API_KEY=
