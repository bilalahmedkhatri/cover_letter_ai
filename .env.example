# Server-only: never prefix payment/storage secrets with VITE_.
NOWPAYMENT_API_KEY=
NOWPAYMENT_IPN_KEY=
# NOWPAYMENT_PUBLIC_KEY is not required for hosted invoices.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
BILLING_SITE_URL=https://ailettergen.com
# Keep disabled until paid AI entitlement enforcement is implemented and launch-tested.
BILLING_ENABLE_CHECKOUT=false
# Sandbox needs a separate NOWPayments sandbox account/key/IPN secret.
NOWPAYMENTS_SANDBOX=false

# Neon Auth: VITE URL is public; DATABASE_URL stays server-only.
VITE_NEON_AUTH_URL=
NEON_AUTH_BASE_URL=
NEON_AUTH_JWKS_URL=
# Exact issuer/audience from this branch's signed JWT; they may differ from the public Auth URL.
NEON_AUTH_ISSUER=
NEON_AUTH_AUDIENCE=
# Server-only random secret (minimum 32 characters).
NEON_AUTH_COOKIE_SECRET=

# Server-only generation provider. Never use NEXT_PUBLIC_ for credentials.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
